    "# Beauty Series \n",
    "terms = int(input(\"how many numbers want to print? \"))\n",
    "num = 0\n",
    "\n",
    "for i in range(terms):\n",
    "    num = num * 10 + 1\n",
    "    print(num, end=\" \")"
